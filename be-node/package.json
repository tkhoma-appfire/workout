{
  "name": "workout-be-node",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/db/migration dist/db/migration",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts migrate",
    "migrate:info": "tsx src/migrate-cli.ts info"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
